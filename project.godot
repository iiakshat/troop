; Engine configuration file.
; Hand-maintained. Input is handled in code (src/game/level_view.gd, src/ui/*).

config_version=5

[application]

config/name="Siren Squad"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/brand/icon.png"
; The rename keeps the save where it was: %APPDATA%/Godot/app_userdata/Troop (the default
; path, written out) on PC. Android keeps user:// in the app's own files dir.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Troop"
boot_splash/bg_color=Color(0.043, 0.078, 0.188, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

Game="*res://src/autoload/game.gd"
Ads="*res://src/autoload/ads.gd"
Analytics="*res://src/autoload/analytics.gd"
Sfx="*res://src/autoload/sfx.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.55, 0.75, 0.92, 1)
